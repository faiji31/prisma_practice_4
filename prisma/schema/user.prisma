model User {
  id           String       @id @default(uuid())
  name         String       @db.VarChar(255)
  email        String       @unique
  password     String
  activeStatus ActiveStatus @default(ACTIVE)
  role         Role         @default(User)
  createAt     DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  profile      Profile?

  posts    Post[]
  comments Comment[]

  @@map("User")
}
